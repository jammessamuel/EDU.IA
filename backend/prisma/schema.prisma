generator client {
  provider = "prisma-client-js"
  // "native" = a minha máquina (dev); "rhel-openssl-3.0.x" = o runtime serverless da Vercel.
  // Sem o target rhel o Prisma não acha o query engine em produção e quebra no boot.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ──────────────────────────────────────────────────────────────
// Postgres nos DOIS ambientes — chega de trocar o provider na mão.
// SQLite (file:) não sobrevive em serverless: o disco da Vercel é
// efêmero/read-only, então o banco sumia a cada cold start.
//
// Uso os nomes que a integração Supabase↔Vercel JÁ injeta no painel
// (confirmei com `vercel env ls`), pra não precisar criar var nenhuma:
//   POSTGRES_PRISMA_URL      → pooled (pgbouncer), usada pela app em runtime
//   POSTGRES_URL_NON_POOLING → direta (5432), usada por `prisma db push`/migrate
// Em DEV, eu defino essas duas no backend/.env apontando pro meu Postgres local.
// ──────────────────────────────────────────────────────────────
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Vertical {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  icon             String
  color            String
  promptTemplate   String
  defaultFields    String
  defaultStages    String
  extractionPrompt String

  workspaces School[]

  @@map("verticals")
}

model School {
  id          String   @id @default(cuid())
  name        String
  subdomain   String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  chatbotName  String  @default("IA Atendente")
  verticalId   String?
  customFields String?
  customStages String?

  vertical Vertical? @relation(fields: [verticalId], references: [id])
  users    User[]
  leads    Lead[]

  @@map("schools")
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  resource String
  action   String
  scope    String

  roles RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  name         String
  schoolId     String
  roleId       String?
  tokenVersion Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  school School  @relation(fields: [schoolId], references: [id])
  role   Role?   @relation(fields: [roleId], references: [id])

  @@unique([schoolId, email])
  @@index([schoolId])
  @@map("users")
}

model Lead {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  phone        String?
  data         String   @default("{}")
  conversation String   @default("[]")
  qualified    Boolean  @default(true)
  status       String   @default("NOVO")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("leads")
}
