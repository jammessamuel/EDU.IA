generator client {
  provider      = "prisma-client-js"
  // "native" = a minha máquina (dev); "rhel-openssl-3.0.x" = o runtime serverless da Vercel.
  // Sem o target rhel o Prisma não acha o query engine em produção e quebra no boot.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ──────────────────────────────────────────────────────────────
// Postgres nos DOIS ambientes — chega de trocar o provider na mão.
// SQLite (file:) não sobrevive em serverless: o disco da Vercel é
// efêmero/read-only, então o banco sumia a cada cold start.
//
// Uso os nomes que a integração Supabase↔Vercel JÁ injeta no painel
// (confirmei com `vercel env ls`), pra não precisar criar var nenhuma:
//   POSTGRES_PRISMA_URL      → pooled (pgbouncer), usada pela app em runtime
//   POSTGRES_URL_NON_POOLING → direta (5432), usada por `prisma db push`/migrate
// Em DEV, eu defino essas duas no backend/.env apontando pro meu Postgres local.
// ──────────────────────────────────────────────────────────────
datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Vertical {
  id               String @id @default(cuid())
  slug             String @unique
  name             String
  icon             String
  color            String
  promptTemplate   String
  defaultFields    String
  defaultStages    String
  extractionPrompt String

  workspaces School[]

  @@map("verticals")
}

model School {
  id        String   @id @default(cuid())
  name      String
  subdomain String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  chatbotName  String  @default("IA Atendente")
  verticalId   String?
  customFields String?
  customStages String?

  vertical        Vertical?               @relation(fields: [verticalId], references: [id])
  users           User[]
  leads           Lead[]
  enrollments     Enrollment[]
  integrationLogs IntegrationLog[]
  profile         SchoolProfile?
  templates       CommunicationTemplate[]
  courseOffers    CourseOffer[]
  documents       DocumentRequirement[]
  commercial      CommercialCondition?
  contactAttempts ContactAttempt[]

  @@map("schools")
}

model SchoolProfile {
  id              String   @id @default(cuid())
  schoolId        String   @unique
  businessHours   String   @default("{}")
  address         String   @default("")
  city            String   @default("")
  state           String   @default("")
  mapLink         String   @default("")
  referencePoints String   @default("")
  transportInfo   String   @default("")
  supportChannels String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_profiles")
}

model CommunicationTemplate {
  id                  String   @id @default(cuid())
  schoolId            String
  key                 String
  title               String
  stage               String
  category            String
  dayOffset           Int?
  whatsappText        String
  defaultWhatsappText String
  active              Boolean  @default(true)
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@index([schoolId, active])
  @@map("communication_templates")
}

model CourseOffer {
  id                  String   @id @default(cuid())
  schoolId            String
  name                String
  description         String   @default("")
  duration            String   @default("")
  modality            String   @default("")
  shifts              String   @default("[]")
  enrollmentFee       Decimal? @db.Decimal(10, 2)
  monthlyFee          Decimal? @db.Decimal(10, 2)
  cashDiscountPercent Decimal? @db.Decimal(5, 2)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, active])
  @@map("course_offers")
}

model DocumentRequirement {
  id           String   @id @default(cuid())
  schoolId     String
  audience     String
  documentType String
  instructions String   @default("")
  required     Boolean  @default(true)
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, audience, active])
  @@map("document_requirements")
}

model CommercialCondition {
  id                  String    @id @default(cuid())
  schoolId            String    @unique
  cashDiscountPercent Decimal?  @db.Decimal(5, 2)
  campaignActive      Boolean   @default(false)
  campaignValidUntil  DateTime?
  promotionText       String    @default("")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("commercial_conditions")
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  resource String
  action   String
  scope    String

  roles RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(cuid())
  email        String
  passwordHash String
  name         String
  schoolId     String
  roleId       String?
  tokenVersion Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Preferências de acessibilidade do operador/admin.
  // Aplicadas no frontend e usadas pelo agente para adaptar linguagem.
  screenReader   Boolean @default(false)
  highContrast   Boolean @default(false)
  colorBlindMode String  @default("none") // none, protanopia, deuteranopia, tritanopia
  reduceMotion   Boolean @default(false)
  simpleLanguage Boolean @default(false)
  fontScale      Float   @default(1.0)

  school School @relation(fields: [schoolId], references: [id])
  role   Role?  @relation(fields: [roleId], references: [id])

  contactAttempts      ContactAttempt[]
  assignedTasks        PostSaleTask[]       @relation("TaskAssignee")
  createdTasks         PostSaleTask[]       @relation("TaskCreator")
  updatedTasks         PostSaleTask[]       @relation("TaskUpdater")
  completedTasks       PostSaleTask[]       @relation("TaskCompleter")
  assignedLeads        Lead[]               @relation("LeadAssignee")
  createdLeads         Lead[]               @relation("LeadCreator")
  confirmedEnrollments Enrollment[]         @relation("EnrollmentConfirmer")
  assignedEnrollments  Enrollment[]         @relation("EnrollmentAssignee")
  ownedPostSaleCases   PostSaleState[]      @relation("PostSaleCaseOwner")
  reviewedDocuments    EnrollmentDocument[] @relation("DocumentReviewer")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@map("users")
}

model Lead {
  id            String    @id @default(cuid())
  schoolId      String
  name          String
  phone         String?
  data          String    @default("{}")
  conversation  String    @default("[]")
  qualified     Boolean   @default(true)
  status        String    @default("NOVO")
  assigneeId    String?
  createdById   String?
  nextContactAt DateTime?
  lastContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school    School @relation(fields: [schoolId], references: [id])
  assignee  User?  @relation("LeadAssignee", fields: [assigneeId], references: [id])
  createdBy User?  @relation("LeadCreator", fields: [createdById], references: [id])

  @@index([schoolId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([schoolId, nextContactAt])
  @@map("leads")
}

// ──────────────────────────────────────────────────────────────
// Matrícula — diferente do Lead (que é só captação). Aqui a IA
// efetiva a matrícula completa do aluno e o sistema emite um
// comprovante (PDF). O Lead de origem fica ligado em leadId.
// ──────────────────────────────────────────────────────────────
model Enrollment {
  id       String  @id @default(cuid())
  schoolId String
  leadId   String? // lead de origem, se a matrícula veio de uma conversa

  number String // nº de matrícula legível: "2026-0042"
  status String @default("RASCUNHO") // RASCUNHO, AGUARDANDO_PAGAMENTO, AGUARDANDO_CONFERENCIA, CONFIRMADA, CANCELADA

  // Identificação principal (colunas diretas p/ busca e p/ o comprovante)
  studentName        String
  cpf                String? // legado/compatibilidade; novo fluxo usa documentType + documentNumber
  documentType       String?
  documentNumber     String?
  preferredLanguage  String?
  countryOfResidence String?
  email              String?
  phone              String?

  // Acadêmico (chaves usadas em relatórios)
  course String?
  shift  String?
  unit   String?

  // Todo o resto dos campos coletados (endereço, responsável,
  // escolaridade…) fica neste JSON — flexível por vertical.
  data String @default("{}")

  // Pagamento (simulado por enquanto; estruturado p/ gateway real depois)
  paymentStatus String   @default("PENDENTE") // PENDENTE, APROVADO, RECUSADO
  paymentMethod String?
  paymentAmount Decimal? @db.Decimal(10, 2)
  paymentRef    String? // id do gateway ("SIMULADO-…" por ora)

  // Código de autenticação do comprovante (vai dentro do QR Code)
  authCode String

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  confirmedAt        DateTime?
  humanConfirmedAt   DateTime?
  humanConfirmedById String?
  assigneeId         String?
  reviewNote         String?
  reviewedAt         DateTime?
  canceledAt         DateTime?

  school           School               @relation(fields: [schoolId], references: [id])
  documents        EnrollmentDocument[]
  humanConfirmedBy User?                @relation("EnrollmentConfirmer", fields: [humanConfirmedById], references: [id])
  assignee         User?                @relation("EnrollmentAssignee", fields: [assigneeId], references: [id])

  @@unique([schoolId, number])
  @@index([schoolId])
  @@index([humanConfirmedById])
  @@index([assigneeId])
  @@index([cpf])
  @@index([documentNumber])
  @@map("enrollments")
}

model EnrollmentDocument {
  id           String    @id @default(cuid())
  enrollmentId String
  type         String // RG, CPF, HISTORICO, COMPROVANTE_RESIDENCIA, FOTO…
  fileName     String
  storagePath  String // "db:<id>" na demo; depois pode virar caminho no Supabase Storage
  content      Bytes? // demo robusta em Vercel/local sem bucket externo
  mimeType     String?
  size         Int?
  uploadedAt   DateTime  @default(now())
  status       String    @default("PENDENTE") // PENDENTE, RECEBIDO, APROVADO, RECUSADO
  reviewNote   String    @default("")
  reviewedAt   DateTime?
  reviewedById String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([enrollmentId])
  @@index([reviewedById])
  @@map("enrollment_documents")
}

model PostSaleState {
  id                 String    @id @default(cuid())
  schoolId           String
  studentKey         String
  enrollmentId       String?
  status             String?
  documentStatus     String?
  contractStatus     String?
  paymentStatus      String?
  accessStatus       String?
  riskScore          Int?
  nextAction         String?
  ownerTeam          String?
  assigneeId         String?
  lifecycleStatus    String    @default("ATIVO") // ATIVO, PAUSADO, ENCERRADO
  lifecycleReason    String?
  nextActionAt       DateTime?
  lastHumanActionAt  DateTime?
  notes              String?
  nextContactAt      DateTime?
  lastContactAt      DateTime?
  lastContactChannel String?
  lastContactOutcome String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignee User? @relation("PostSaleCaseOwner", fields: [assigneeId], references: [id])

  @@unique([schoolId, studentKey])
  @@index([schoolId])
  @@index([enrollmentId])
  @@index([assigneeId])
  @@index([schoolId, lifecycleStatus, nextActionAt])
  @@map("post_sale_states")
}

model PostSaleTask {
  id                     String    @id @default(cuid())
  schoolId               String
  studentKey             String?
  leadId                 String?
  enrollmentId           String?
  studentName            String
  title                  String
  ownerTeam              String
  assignee               String    @default("")
  assigneeId             String?
  role                   String    @default("secretaria")
  priority               String    @default("Normal")
  status                 String    @default("ABERTA")
  column                 String    @default("a_fazer")
  origin                 String    @default("manual")
  createdBy              String    @default("humano")
  createdById            String?
  updatedById            String?
  completedById          String?
  automation             String?
  relatedEntity          String    @default("{}")
  autoResolve            Boolean   @default(false)
  dueAt                  DateTime?
  recurrenceIntervalDays Int?
  canceledAt             DateTime?
  firstMovedAt           DateTime?
  resolvedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  assignedUser    User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdByUser   User? @relation("TaskCreator", fields: [createdById], references: [id])
  updatedByUser   User? @relation("TaskUpdater", fields: [updatedById], references: [id])
  completedByUser User? @relation("TaskCompleter", fields: [completedById], references: [id])

  @@index([schoolId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([updatedById])
  @@index([completedById])
  @@index([studentKey])
  @@index([leadId])
  @@index([enrollmentId])
  @@index([schoolId, status])
  @@index([schoolId, column])
  @@index([schoolId, origin])
  @@map("post_sale_tasks")
}

model ContactAttempt {
  id              String    @id @default(cuid())
  schoolId        String
  studentKey      String?
  leadId          String?
  channel         String
  outcome         String
  note            String    @default("")
  nextContactAt   DateTime?
  contactedById   String?
  contactedByName String    @default("")
  createdAt       DateTime  @default(now())

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  contactedBy User?  @relation(fields: [contactedById], references: [id])

  @@index([schoolId])
  @@index([studentKey])
  @@index([leadId])
  @@index([schoolId, nextContactAt])
  @@map("contact_attempts")
}

model PostSaleEvent {
  id           String   @id @default(cuid())
  schoolId     String
  studentKey   String
  enrollmentId String?
  studentName  String
  type         String
  title        String
  description  String
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([schoolId])
  @@index([studentKey])
  @@index([enrollmentId])
  @@map("post_sale_events")
}

model IntegrationLog {
  id              String   @id @default(cuid())
  schoolId        String
  studentKey      String?
  enrollmentId    String?
  studentName     String?
  service         String
  action          String
  status          String
  requestPayload  String   @default("{}")
  responsePayload String   @default("{}")
  visibleMessage  String
  createdAt       DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([studentKey])
  @@index([enrollmentId])
  @@map("integration_logs")
}
