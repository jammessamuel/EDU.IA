# ============================================================
# Variáveis de ambiente do backend (EDU.IA)
# Copie para .env e preencha. No Vercel, configure no painel
# (Project Settings -> Environment Variables).
# ============================================================

# Supabase — conexão POOLED (pgbouncer, porta 6543). Usada pela app em runtime.
# Pegue em: Supabase -> Project Settings -> Database -> Connection string -> "Transaction" pooler
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase — conexão DIRETA (porta 5432). Usada por `prisma db push` / migrations.
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Chave da OpenAI
OPENAI_API_KEY="sk-..."

# Segredo para assinar os JWT (use uma string longa e aleatória em produção)
JWT_SECRET="troque-por-um-segredo-forte"

# URL(s) do frontend para liberar no CORS (separadas por vírgula). Ex.: https://eduia.vercel.app
FRONTEND_URL="https://seu-frontend.vercel.app"
