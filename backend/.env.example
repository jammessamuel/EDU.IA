# ============================================================
# Variáveis de ambiente do backend (EDU.IA)
# Copie para .env e preencha. Em produção (Vercel), a integração
# Supabase↔Vercel já injeta as POSTGRES_* automaticamente no painel.
# ============================================================

# ── BANCO (Postgres) ─────────────────────────────────────────
# Em PROD, estas vêm da integração Supabase na Vercel (não precisa setar à mão):
#   POSTGRES_PRISMA_URL      → pooled (pgbouncer), usada pela app em runtime
#   POSTGRES_URL_NON_POOLING → direta (5432), usada por `prisma db push`/migrate
# Em DEV, aponte as duas pro seu Postgres local (Homebrew) ou um Postgres na nuvem:
POSTGRES_PRISMA_URL="postgresql://USER:SENHA@localhost:5432/eduflow?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://USER:SENHA@localhost:5432/eduflow?schema=public"

# ── Chave da OpenAI (para o chat de IA) ──────────────────────
OPENAI_API_KEY="sk-..."

# ── Segredo dos JWT (OBRIGATÓRIO em produção) ────────────────
JWT_SECRET="troque-por-um-segredo-forte"

# ── URL(s) do frontend para o CORS (separadas por vírgula) ───
FRONTEND_URL="https://seu-frontend.vercel.app"
